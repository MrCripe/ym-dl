{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ym-dl",
  "version": "1.1.1",
  "identifier": "dev.ymdl.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MrCripe/ym-dl/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwQkI5Nzc1QkM5QzU0QzEKUldUQlZKeThkWmU3Z0pJZjRhS2hwZHQxWk01cmtDekpuNjM4UlhYZkN0bTRISStBSENNT0hvODYK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Загрузчик Яндекс.Музыки",
    "longDescription": "Скачивание треков, альбомов, плейлистов и любимых песен с Яндекс.Музыки в FLAC.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
